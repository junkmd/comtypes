index 4187dc8..7c1821c 100644
--- a/comtypes/__init__.py
+++ b/comtypes/__init__.py
@@ -267,8 +267,23 @@ class CoClass(COMObject, metaclass=_coclass_meta):
 ################################################################
 
 
+class AccessViolationError(OSError):
+    """A COM call failed with a Windows access violation (SEH exception).
+
+    `ctypes` reports a Windows structured exception handling (SEH) fault as a
+    plain `OSError` whose message starts with ``exception:``.  This subclass
+    makes the access violation case distinguishable from other `OSError`s, so
+    that callers can react to it (for example by skipping a test) without
+    matching on the error message themselves.
+    """
+
+
+################################################################
+
+
 # fmt: off
 __known_symbols__ = [
+    "AccessViolationError",
     "BIND_OPTS", "tagBIND_OPTS", "BINDOPTS2", "tagBIND_OPTS2", "BSTR",
     "_check_version", "CLSCTX", "tagCLSCTX", "CLSCTX_ALL",
     "CLSCTX_DISABLE_AAA", "CLSCTX_ENABLE_AAA", "CLSCTX_ENABLE_CODE_DOWNLOAD",
diff --git a/comtypes/automation.py b/comtypes/automation.py
index a1b6e14..e5fe1db 100644
--- a/comtypes/automation.py
+++ b/comtypes/automation.py
@@ -307,7 +307,33 @@ class IDispatch(IUnknown):
 
     def GetTypeInfo(self, index: int, lcid: int = 0) -> "hints.ITypeInfo":
         """Return type information.  Index 0 specifies typeinfo for IDispatch"""
-        result = self._GetTypeInfo(index, lcid)  # type: ignore
+        try:
+            result = self._GetTypeInfo(index, lcid)  # type: ignore
+        except COMError:
+            # A normal COM failure (for example `DISP_E_BADINDEX`); let it
+            # through unchanged.
+            raise
+        except OSError as e:
+            # `ctypes` reports a Windows SEH fault as a plain `OSError` whose
+            # message starts with "exception:".  An access violation here means
+            # the server returned an `ITypeInfo` that could not be marshaled
+            # (this happens for the LOCAL_SERVER in
+            # `test_comserver.TestLocalServer.test_get_typeinfo`).  Re-raise it
+            # as `AccessViolationError` so that callers can distinguish it from
+            # other `OSError`s.
+            if "access violation" in str(e):
+                raise comtypes.AccessViolationError(str(e)) from e
+            raise
+        # A server is allowed to return `S_OK` with a NULL `ppTypeInfo` (for
+        # example when it has no type information).  Calling `QueryInterface`
+        # on a NULL pointer would raise an access violation, so guard against
+        # it and report a proper COM error instead.
+        if not result:
+            raise COMError(
+                hresult.E_UNEXPECTED,
+                "IDispatch::GetTypeInfo returned a NULL ITypeInfo",
+                (None, None, None, 0, None),
+            )
         return result.QueryInterface(comtypes.typeinfo.ITypeInfo)
 
     def GetIDsOfNames(self, *names: str, **kw: Any) -> list[int]:
