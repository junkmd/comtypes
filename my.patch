+class TestDebugOSError(unittest.TestCase):
+    def test_debug(self):
+        obj = CreateObject(
+            "TestComServerLib.TestComServer", clsctx=comtypes.CLSCTX_LOCAL_SERVER
+        )
+        try:
+            obj.GetTypeInfo(0)
+        except OSError as e:
+            print(
+                f"DEBUG raised: {e!r} errno={e.errno!r} "
+                f"winerror={getattr(e, 'winerror', None)!r} "
+                f"strerror={e.strerror!r} args={e.args!r}",
+                file=sys.stderr,
+            )
+            cause = e.__cause__
+            if cause is not None:
+                print(
+                    f"DEBUG cause: {cause!r} errno={cause.errno!r} "
+                    f"winerror={getattr(cause, 'winerror', None)!r} "
+                    f"strerror={cause.strerror!r} args={cause.args!r}",
+                    file=sys.stderr,
+                )
